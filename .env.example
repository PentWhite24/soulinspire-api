# PostgreSQL. Either one DATABASE_URL...
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/soulinspire
# ...or separate settings (the AWS servers' boot script writes these):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=soulinspire
DB_USER=postgres
DB_PASSWORD=postgres
# true on AWS: RDS only accepts encrypted connections
DB_SSL=false
# Path to the RDS certificate bundle when DB_SSL=true
DB_SSL_CA=
# Connections per process (2 servers x 2 processes x 10 = 40)
DB_POOL_MAX=10
