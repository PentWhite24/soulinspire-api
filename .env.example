# Copy to .env and fill in. Every value has a safe default for local development.

PORT=4000
NODE_ENV=development
DATABASE_FILE=data/soulinspire.db

# Storefront address(es) allowed to call this API from the browser (comma-separated).
# Must match exactly, e.g. https://soulinspire.ng,https://www.soulinspire.ng
CORS_ORIGINS=http://localhost:5173
# Storefront address customers return to after paying by card
FRONTEND_URL=http://localhost:5173

# Long random string; turns on /api/admin. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=

# Paystack secret key (sk_test_... or sk_live_...). Leave empty for demo payments.
PAYSTACK_SECRET_KEY=

# Shown to customers who pay by bank transfer
BANK_NAME=
BANK_ACCOUNT_NAME=Soulinspire Ltd
BANK_ACCOUNT_NUMBER=

PICKUP_ADDRESS=Lekki Phase 1, Lagos
UNPAID_ORDER_TTL_MINUTES=30
